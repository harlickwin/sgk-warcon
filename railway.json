{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "DOCKERFILE",
		"dockerfilePath": "Dockerfile"
	},
	"deploy": {
		"healthcheckPath": "/api/health",
		"healthcheckTimeout": 300,
		"restartPolicyType": "ALWAYS",
		"sleepApplication": false,
		"drainingSeconds": 20,
		"multiRegionConfig": {
			"asia-southeast1-eqsg3a": { "numReplicas": 1 }
		}
	}
}
